docker {
    enabled = true
    runOptions = "--entrypoint=''"
}
report {
    enabled = true
    overwrite = true
    file = 'reports/report.html'
}
trace {
    enabled = true
    overwrite = true
    file = 'reports/trace.txt'
}
timeline {
    enabled = true
    overwrite = true
    file = 'reports/timeline.html'
}
dag {
    enabled = true
    overwrite = true
    file = 'reports/dag.dot'
}
process {
    executor = 'local'
    scratch = false
    maxRetries = 30
    errorStrategy = 'retry'
}